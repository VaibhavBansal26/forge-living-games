{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forge-living-games",
  "main": "cloudflare/index.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/chess-ws", "/ws"]
  },
  "durable_objects": {"bindings": [{"name": "FORGE", "class_name": "ForgeCommunity"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ForgeCommunity"]}],
  "observability": {"enabled": false}
}
